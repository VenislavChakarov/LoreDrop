@using LoreDrop.Web.ViewModels.Favorites
@model IEnumerable<FavoriteSereisViewModel>

@{
    ViewData["Title"] = "Your Favorite";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/favorites.css" asp-append-version="true" />
}

<div class="favorites-page">
    <div class="favorites-header">
        <h1>Your Favorite</h1>
    </div>

    @if (!Model.Any())
    {
        <div class="fav-empty">
            <p>You haven’t added any favorites yet.</p>
            <p><a href="@Url.Action("Index", "Series")" class="btn-detail">Browse Series</a></p>
        </div>
    }
    else
    {
        <div class="favorites-grid" id="favorites-grid">
            @foreach (var item in Model)
            {
                <div class="fav-card" data-title="@item.Title.ToLower()">
                    <img src="@(item.ImageUrl ?? "/images/placeholder.jpg")" alt="@item.Title" />
                    <div class="card-body">
                        <h3>@item.Title</h3>
                        <p class="meta genre"><strong>Genre:</strong> @item.Genre</p>
                        <p class="meta author"><strong>Author:</strong> @item.Author</p>
                        <p class="meta created-on"><strong>Created On:</strong> @item.CreatedOn</p>
                        <div class="card-actions">
                            <a href="@Url.Action("Details", "Details", new { id = item.SeriesId })" 
                               class="btn-detail">Details</a>
                            <form asp-action="RemoveFromFavorites" asp-controller="Favorite" method="post" class="d-inline btn-remove">
                                <input type="hidden" name="seriesId" value="@item.SeriesId" />
                                <button class="btn-remove" data-series-id="@item.SeriesId">Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
}