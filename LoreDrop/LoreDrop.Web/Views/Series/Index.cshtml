@using static LoreDrop.GCommon.ValidationConstants.Series;
@model IEnumerable<LoreDrop.Web.ViewModels.Series.AllSeriesIndexViewModel>

@{
    ViewData["Title"] = "All Series";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/series.css" asp-append-version="true" />
}

<div class="series-page">
    <h1 class="page-title">@ViewData["Title"]</h1>

   <div class="autocomplete">
  <div class="fav-filter">
    <input id="filter-input" />
    <button id="filter-btn"><i class="fas fa-search"></i></button>
  </div>
  <ul id="suggestions" class="suggestions-list"></ul>
</div>

    @* serialize series into a hidden script tag for JS to pick up *@
    <script id="series-data" type="application/json">@Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.Select(s => new { s.Id, s.Title })
        )
        )</script>

    @if (!Model.Any())
    {
        <p class="no-series">No series have been created yet.</p>
    }
    else
    {
        <div class="series-grid">
            @foreach (var series in Model)
            {
                <div class="series-card" data-id="@series.Id">
                    <a asp-controller="Details" asp-action="Details" asp-route-id="@series.Id" class="card-link">
                        <div class="card-image">
                            <img src="@(series.ImageUrl ?? "/images/placeholder.jpg")"
                                 alt="@series.Title" />
                        </div>
                        <div class="card-content">
                            <h3>@series.Title</h3>

                            <p class="genre">@series.Genre</p>

                            <p class="rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (series.Rating >= i)
                                    {
                                        <i class="fas fa-star" aria-hidden="true"></i>
                                    }
                                    else if (series.Rating >= i - 0.5)
                                    {
                                        <i class="fas fa-star-half-alt" aria-hidden="true"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star" aria-hidden="true"></i>
                                    }
                                }
                                <span class="visually-hidden">Rating: @series.Rating out of 5</span>
                            </p>
                            <p class="author">Author: @series.Author</p>
                            <p class="date">Created on @DateTime.Parse(series.CreatedOn).ToString(DateFormat)</p>
                        </div>
                    </a>
                    <a asp-controller="Details" asp-action="Details" asp-route-id="@series.Id" class="btn-details">
                        View Details
                    </a>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/search-bar.js?v=@DateTime.UtcNow.Ticks"></script>
}