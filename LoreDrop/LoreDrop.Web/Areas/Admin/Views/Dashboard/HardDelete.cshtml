@model LoreDrop.Web.ViewModels.Admin.SeriesAdmin.HardDeleteSeriesViewModel

@{
    ViewData["Title"] = "Delete Series";
    Layout = "_Layout";
}

<link rel="stylesheet" asp-href-include="~/css/delete-page.css" />

<div class="delete-container">
    <div class="delete-card">
        <div class="delete-card-header">
            <h3>Confirm Delete</h3>
        </div>
        <div class="delete-card-body">
            <p>Are you sure you want to delete:</p>
            <h4>@Model.Tittle</h4>
            <h5>by @Model.Author</h5>

            <div class="delete-buttons">
                <form asp-action="HardDelete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Tittle" />
                    <input type="hidden" asp-for="Author" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-confirm-delete">
                        <i class="fa fa-trash"></i> Yes, Delete Permanently
                    </button>
                </form>
                <a asp-action="Index" class="btn-cancel">
                    <i class="fa fa-arrow-left"></i> Cancel
                </a>
            </div>
        </div>
    </div>
</div>